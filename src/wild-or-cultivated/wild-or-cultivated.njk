---
pagination:
  data: collections.photoWildOrCultivated
  size: 1
  alias: group
  # Eleventy adds only the FIRST page of a paginated set to collections.all,
  # which the sitemap iterates - so until 3 September 2026 the sitemap listed
  # one archive page per section (the alphabetically first group) and omitted
  # 101 of 296 pages. The sitemap is the only consumer of collections.all.
  addAllPagesToCollections: true
permalink: "/wild-or-cultivated/{{ group.slug }}/"
layout: base.njk
eleventyComputed:
  title: "{{ group.key }}"
  description: "{% if group.key == 'Wild' %}Wildlife, nature and macro photographs of subjects living and growing wild — nothing kept, nothing planted, nothing tended.{% else %}Nature and macro photographs of cultivated subjects — gardens, parks, ornamental ponds and planted trees.{% endif %}"
---
<h1 class="page-title">{{ group.key }}</h1>
<p class="page-intro">
  {% if group.key == "Wild" %}
    Subjects living and growing wild — nothing kept, nothing planted, nothing tended.
  {% else %}
    Plant subjects that were planted or tended: gardens, parks, ornamental ponds and street trees.
  {% endif %}
  <a href="/wild-or-cultivated/">Wild or cultivated</a>
</p>
<ul class="gallery-grid">
{% for photo in group.items %}
  <li class="gallery-grid__item">
    <a href="{{ photo.url }}">
      <img src="/images/photos/{{ photo.data.image }}" alt="{{ photo.data.alt }}" loading="lazy" />
      <span class="gallery-grid__caption">{{ photo.data.title }}</span>
    </a>
  </li>
{% endfor %}
</ul>
