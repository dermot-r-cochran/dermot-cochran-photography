---
pagination:
  data: collections.photoYears
  size: 1
  alias: group
permalink: "/year/{{ group.key }}/"
layout: base.njk
eleventyComputed:
  title: "{{ group.key }}"
  description: "Photos taken in {{ group.key }}."
---
<h1 class="page-title">{{ group.key }}</h1>
<p class="page-intro"><a href="/year/">All years</a></p>
<ul class="gallery-grid">
{% for photo in group.items %}
  <li class="gallery-grid__item">
    <a href="{{ photo.url }}">
      <img src="/images/photos/{{ photo.data.image }}" alt="{{ photo.data.alt }}" loading="lazy" />
      <span class="gallery-grid__caption">{{ photo.data.title }}</span>
    </a>
  </li>
{% endfor %}
</ul>
