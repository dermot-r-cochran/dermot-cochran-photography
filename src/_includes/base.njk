<!DOCTYPE html>
<html lang="{{ site.language | default('en') }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="{{ description | default(site.description) }}" />
  {#- What this domain is serving; also at /version.txt. See src/_data/build.js. -#}
  <meta name="site-version" content="{{ build.version }}" />
  <title>{% if title %}{{ title }} | {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  <link rel="stylesheet" href="/css/main.css?v={{ build.cssVersion }}" />

  <link rel="icon" href="/images/icons/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="icon" href="/images/icons/favicon-16.png" sizes="16x16" type="image/png" />
  <link rel="apple-touch-icon" href="/images/icons/favicon-180.png" />

  {#- SELF-canonical: this site declares itself the canonical home of its own
      URLs. Until August 2026 it emitted no canonical at all, which left every
      variant of an address - http and https, www and apex - answering 200 with
      nothing to say which one Google should keep. That is the "Duplicate
      without user-selected canonical" status in Search Console: not a penalty,
      but Google picking a winner on your behalf and dropping the rest.

      Built from page.url + site.url, so it matches og:url above exactly and
      picks up SITE_DOMAIN from deploy.conf with no per-page configuration.

      The force-HTTPS 301 in src/static/.htaccess is the other half of this and
      the two are deliberately both present: the redirect stops crawlers
      fetching the http duplicates at all, and the canonical is what answers
      for every other variant an Apache rule doesn't catch. -#}
  <link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}" />

  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="{{ title | default(site.title) }}" />
  <meta property="og:description" content="{{ description | default(site.description) }}" />
  <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title | default(site.title) }}" />
  <meta name="twitter:description" content="{{ description | default(site.description) }}" />
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <header class="site-header" role="banner">
    <div class="site-header__inner">
      <a class="site-logo" href="/">
        <span class="site-logo__icon" aria-hidden="true">◆</span>
        <span class="site-logo__text">{{ site.name }}</span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        <ul class="site-nav__list" role="list">
          <li><a href="/" {% if page.url == "/" %}aria-current="page"{% endif %}>Home</a></li>
          <li><a href="/gallery/" {% if "/gallery/" in page.url %}aria-current="page"{% endif %}>Gallery</a></li>
          <li><a href="/albums/" {% if "/albums/" in page.url %}aria-current="page"{% endif %}>Albums</a></li>
          <li><a href="/about/" {% if "/about/" in page.url %}aria-current="page"{% endif %}>About</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main-content" class="main-content">
    {{ content | safe }}

    {% if comments and giscus.categoryId %}
    <section class="site-comments" aria-label="Comments">
      <h2 class="site-comments__heading">Discussion</h2>
      <script src="https://giscus.app/client.js"
        data-repo="{{ giscus.repo }}"
        data-repo-id="{{ giscus.repoId }}"
        data-category="{{ giscus.category }}"
        data-category-id="{{ giscus.categoryId }}"
        data-mapping="pathname"
        data-strict="1"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="dark"
        data-lang="en"
        crossorigin="anonymous"
        async>
      </script>
    </section>
    {% endif %}
  </main>

  <footer class="site-footer" role="contentinfo">
    <div class="site-footer__inner">
      <p>
        <span>{{ site.name }}</span>. Copyright © {{ build.copyrightYears }} Dermot R. Cochran.
        Photographs licensed under <a href="https://creativecommons.org/licenses/by-nc-nd/4.0/">CC BY-NC-ND 4.0</a>;
        site code under <a href="/license/">MIT</a>.
      </p>
    </div>
  </footer>

  {% if page.url == "/" %}
  <script src="/js/slideshow.js?v={{ build.slideshowVersion }}" defer></script>
  {% endif %}
</body>
</html>
