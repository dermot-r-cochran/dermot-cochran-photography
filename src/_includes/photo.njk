---
layout: base.njk
comments: true
eleventyComputed:
  # A photo may carry its own one-line `description:` in front matter. Where it
  # does, that is the meta description and the search-result snippet; where it
  # does not, fall back to the generated formula. The fallback is deliberately
  # kept - a photo with nothing worth saying about it should not be forced to
  # invent something, and the formula is better than an empty tag.
  description: "{{ description if description else title + ' — ' + category + ' photograph, ' + location + ', ' + year + '.' }}"
---
<article class="photo-detail">
  <img class="photo-detail__image" src="/images/photos/{{ image }}" alt="{{ alt }}" />
  <h1 class="page-title">{{ title }}</h1>

  {# Optional note. Renders only when the .md file has body text, so photos
     without one look finished rather than incomplete. The house rule for
     writing one: never describe what is visible - add what is not. #}
  {% if content %}
  <div class="photo-note">{{ content | safe }}</div>
  {% endif %}
  <dl class="photo-meta">
    <div class="photo-meta__row">
      <dt>Category</dt>
      <dd><a href="/category/{{ category | slugify }}/">{{ category }}</a></dd>
    </div>
    <div class="photo-meta__row">
      <dt>Location</dt>
      <dd><a href="/location/{{ location | slugify }}/">{{ location }}</a></dd>
    </div>
    {% set country = location | countryOf %}
    {% if country %}
    <div class="photo-meta__row">
      <dt>Country</dt>
      <dd><a href="/country/{{ country | slugify }}/">{{ country }}</a></dd>
    </div>
    {% endif %}
    {% set grown = { category: category, competitions: competitions } | wildOrCultivated %}
    {% if grown %}
    <div class="photo-meta__row">
      <dt>Subject</dt>
      <dd><a href="/wild-or-cultivated/{{ grown | slugify }}/">{{ grown }}</a></dd>
    </div>
    {% endif %}
    {% set place = { category: category, competitions: competitions, setting: setting } | naturalOrBuilt %}
    {% if place %}
    <div class="photo-meta__row">
      <dt>Setting</dt>
      <dd><a href="/natural-or-built/{{ place | slugify }}/">{{ place }}</a></dd>
    </div>
    {% endif %}
    <div class="photo-meta__row">
      <dt>Year</dt>
      <dd><a href="/year/{{ year }}/">{{ year }}</a></dd>
    </div>
    {% if album %}
    <div class="photo-meta__row">
      <dt>Album</dt>
      <dd><a href="/albums/{{ album | slugify }}/">{{ album }}</a></dd>
    </div>
    {% endif %}
  </dl>
  <p class="photo-license">
    © {{ copyrightYear }} Dermot R. Cochran — licensed under
    <a href="https://creativecommons.org/licenses/by-nc-nd/4.0/">CC BY-NC-ND 4.0</a>.
  </p>
  <p><a href="/gallery/">← Back to Gallery</a></p>
</article>
